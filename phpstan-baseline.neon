parameters:
	ignoreErrors:
		-
			message: '#^Argument of an invalid type mixed supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: Action/RatingAction.php

		-
			message: '#^Binary operation "\." between ''Canpar '' and mixed results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: Action/RatingAction.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 3
			path: Action/RatingAction.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 1
			path: Action/ShippingAction.php

		-
			message: '#^Method Omnibus\\Canpar\\Api\:\:secrets\(\) should return list\<string\> but returns non\-empty\-array\<int\<0, max\>\|string, string\>\.$#'
			identifier: return.type
			count: 1
			path: Api.php

		-
			message: '#^Parameter \#1 \$data of function simplexml_load_string expects string, string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: Api.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 3
			path: CanparGatewayFactory.php

		-
			message: '#^Parameter \#3 \$province of static method Omnibus\\Canpar\\Mapping\:\:address\(\) expects string\|null, mixed given\.$#'
			identifier: argument.type
			count: 2
			path: Mapping.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 1
			path: Tests/CanparContractTest.php

		-
			message: '#^Cannot access offset 1 on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 6
			path: Tests/CanparGatewayTest.php

		-
			message: '#^Cannot access property \$location on Omnibus\\Model\\TrackingEvent\|null\.$#'
			identifier: property.nonObject
			count: 1
			path: Tests/CanparGatewayTest.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 1
			path: Tests/CanparGatewayTest.php

		-
			message: '#^Parameter \#2 \$haystack of static method PHPUnit\\Framework\\Assert\:\:assertStringContainsString\(\) expects string, mixed given\.$#'
			identifier: argument.type
			count: 6
			path: Tests/CanparGatewayTest.php

		-
			message: '#^Property Omnibus\\Canpar\\Tests\\CanparGatewayTest\:\:\$calls type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Tests/CanparGatewayTest.php
